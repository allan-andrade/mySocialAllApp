{
  "name": "@social-publisher/worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@social-publisher/crypto": "workspace:*",
    "@social-publisher/database": "workspace:*",
    "@social-publisher/shared": "workspace:*",
    "@social-publisher/social-connectors": "workspace:*",
    "bullmq": "^5.34.2"
  },
  "devDependencies": {
    "@social-publisher/config": "workspace:*",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^7.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
