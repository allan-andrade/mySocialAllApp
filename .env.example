# Copie este arquivo para `.env` na raiz e ajuste os valores conforme necessário.
# Os valores abaixo já batem com os defaults do docker-compose.yml para rodar localmente
# com um único comando. Nenhum valor real de produção deve ir para este arquivo.

# ── Ambiente ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Modo dos conectores de redes sociais. "mock" simula todas as integrações
# (sem credenciais reais); "live" exige as credenciais OAuth de cada provedor
# e nunca cai para mock silenciosamente. Ver seção 22 do briefing do produto.
SOCIAL_CONNECTOR_MODE=mock

# ── Banco de dados / filas ───────────────────────────────────────────────
# Porta 5433 (não 5432) para não colidir com um PostgreSQL nativo já rodando na máquina.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/social_publisher?schema=public"
REDIS_URL="redis://localhost:6379"

# ── Sessão e criptografia ────────────────────────────────────────────────
# Gere valores fortes locais com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string
# Chave usada para criptografar tokens OAuth em repouso (AES-256-GCM). Em produção,
# substitua por uma chave gerenciada por KMS (ver packages/database e apps/api docs).
TOKEN_ENCRYPTION_KEY=replace-with-a-random-32-byte-key-base64

# ── Armazenamento compatível com S3 (MinIO local) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=social-publisher-media
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=minio_admin_password

# ── Meta (Instagram, Threads, Facebook Pages) ────────────────────────────
# https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/v1/social-connections/facebook_page/callback

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:4000/api/v1/social-connections/threads/callback

# ── X (Twitter) ───────────────────────────────────────────────────────────
# https://developer.x.com/en/portal/dashboard
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/api/v1/social-connections/x/callback
